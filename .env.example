# ==============================================================================
# LocalLedger AI - Environment Configuration Template
# All processing runs locally on your machine. No cloud AI or telemetry.
# ==============================================================================

# Application Environment (development | production | test)
APP_ENV=development

# Backend Network Binding (Strict loopback by default)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Local Storage Locations (Relative to workspace root or absolute path)
DATA_DIR=data
DB_PATH=data/db/localledger.db
UPLOAD_DIR=data/uploads

# Ingestion Limits
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=15

# Local AI Engine (Ollama)
# NOTE: Must be a loopback host (127.0.0.1 / localhost) to prevent SSRF
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60

# Local OCR Engine (Tesseract)
# Leave blank to auto-detect from PATH, or specify exact binary path on Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
